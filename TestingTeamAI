<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Testing Framework — Trane Technologies</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=IBM+Plex+Mono:wght@300;400;500&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap');

  :root {
    --red: #C1272D;
    --red-dark: #8B1A1E;
    --red-glow: rgba(193,39,45,0.18);
    --charcoal: #1A1A1A;
    --offwhite: #F5F3EE;
    --warm-gray: #9A9490;
    --card-bg: #242220;
    --border: rgba(193,39,45,0.25);
    --text: #E8E4DC;
    --dim: #7A756F;
  }

  * { margin:0; padding:0; box-sizing:border-box; }

  body {
    font-family: 'IBM Plex Sans', sans-serif;
    background: var(--charcoal);
    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* NOISE TEXTURE */
  body::before {
    content:'';
    position:fixed; inset:0; z-index:0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events:none; opacity:0.6;
  }

  /* ---- HEADER ---- */
  header {
    position: relative; z-index:10;
    padding: 48px 60px 36px;
    border-bottom: 1px solid var(--border);
    display: flex; align-items: flex-start; justify-content: space-between;
    background: linear-gradient(135deg, rgba(193,39,45,0.07) 0%, transparent 60%);
  }
  .logo-block { display:flex; align-items:center; gap:16px; }
  .trane-logo {
    width:52px; height:52px; border-radius:8px;
    background: var(--red);
    display:flex; align-items:center; justify-content:center;
    font-family:'Syne',sans-serif; font-weight:800; font-size:22px; color:#fff;
    letter-spacing:-1px; flex-shrink:0;
  }
  .brand-text { }
  .brand-text h1 { font-family:'Syne',sans-serif; font-size:13px; font-weight:600; letter-spacing:3px; text-transform:uppercase; color:var(--red); }
  .brand-text p  { font-family:'IBM Plex Mono',monospace; font-size:11px; color:var(--dim); margin-top:3px; }
  .header-title { text-align:right; }
  .header-title h2 { font-family:'Syne',sans-serif; font-size:28px; font-weight:800; line-height:1.1; }
  .header-title span { color:var(--red); }
  .header-title p { font-family:'IBM Plex Mono',monospace; font-size:11px; color:var(--dim); margin-top:6px; letter-spacing:1px; }

  /* ---- NAV TABS ---- */
  nav {
    position: sticky; top:0; z-index:50;
    background: rgba(26,26,26,0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    padding: 0 60px;
    display:flex; gap:0; overflow-x:auto;
  }
  nav button {
    background:none; border:none; cursor:pointer;
    font-family:'IBM Plex Mono',monospace; font-size:11px; letter-spacing:1.5px;
    text-transform:uppercase; color:var(--dim);
    padding:16px 22px; border-bottom:2px solid transparent;
    transition:all 0.2s; white-space:nowrap;
  }
  nav button:hover { color:var(--text); }
  nav button.active { color:var(--red); border-bottom-color:var(--red); }

  /* ---- MAIN ---- */
  main { position:relative; z-index:5; }
  .section { display:none; padding:60px; }
  .section.active { display:block; }

  /* ---- SECTION TITLE ---- */
  .sec-title {
    font-family:'Syne',sans-serif; font-size:38px; font-weight:800;
    line-height:1.05; margin-bottom:10px;
  }
  .sec-title span { color:var(--red); }
  .sec-sub {
    font-family:'IBM Plex Mono',monospace; font-size:12px;
    color:var(--dim); letter-spacing:1px; margin-bottom:48px;
  }

  /* ---- FLOW DIAGRAM ---- */
  .flow-wrap {
    display:flex; flex-direction:column; align-items:center; gap:0;
    max-width:900px; margin:0 auto;
  }
  .flow-stage {
    width:100%; position:relative;
  }
  .flow-connector {
    display:flex; flex-direction:column; align-items:center;
    padding: 6px 0;
  }
  .flow-line { width:2px; height:30px; background:var(--red); opacity:0.5; }
  .flow-arrow {
    width:0; height:0;
    border-left:8px solid transparent;
    border-right:8px solid transparent;
    border-top:10px solid var(--red);
    opacity:0.7;
  }

  .stage-card {
    border: 1px solid var(--border);
    border-radius:12px;
    background: var(--card-bg);
    padding:28px 32px;
    cursor:pointer;
    transition: all 0.25s;
    position:relative;
    overflow:hidden;
  }
  .stage-card::before {
    content:'';
    position:absolute; left:0; top:0; bottom:0; width:4px;
    background:var(--red); border-radius:4px 0 0 4px;
    transform:scaleY(0); transition:transform 0.25s;
    transform-origin:top;
  }
  .stage-card:hover { border-color:var(--red); background:#2A2826; transform:translateX(4px); }
  .stage-card:hover::before { transform:scaleY(1); }
  .stage-card.expanded { border-color:var(--red); background:#2A2826; }
  .stage-card.expanded::before { transform:scaleY(1); }

  .stage-header {
    display:flex; align-items:center; gap:16px;
  }
  .stage-num {
    width:38px; height:38px; border-radius:50%;
    background:var(--red); display:flex; align-items:center; justify-content:center;
    font-family:'Syne',sans-serif; font-weight:800; font-size:14px; flex-shrink:0;
  }
  .stage-info { flex:1; }
  .stage-info h3 { font-family:'Syne',sans-serif; font-size:17px; font-weight:700; }
  .stage-info p { font-family:'IBM Plex Mono',monospace; font-size:11px; color:var(--dim); margin-top:3px; }
  .stage-badge {
    font-family:'IBM Plex Mono',monospace; font-size:10px;
    background:var(--red-glow); color:var(--red);
    border:1px solid var(--border); border-radius:4px;
    padding:4px 10px; letter-spacing:1px; text-transform:uppercase; flex-shrink:0;
  }
  .stage-toggle {
    font-size:18px; color:var(--dim); transition:transform 0.3s; flex-shrink:0;
  }
  .stage-card.expanded .stage-toggle { transform:rotate(180deg); color:var(--red); }

  .stage-detail {
    display:none; margin-top:24px; padding-top:24px;
    border-top:1px solid rgba(255,255,255,0.06);
  }
  .stage-card.expanded .stage-detail { display:block; }

  .detail-grid {
    display:grid; grid-template-columns:1fr 1fr; gap:20px;
  }
  .detail-block { }
  .detail-block h4 {
    font-family:'IBM Plex Mono',monospace; font-size:10px; letter-spacing:2px;
    text-transform:uppercase; color:var(--red); margin-bottom:10px;
  }
  .detail-block ul { list-style:none; }
  .detail-block ul li {
    font-size:13px; color:var(--text); opacity:0.85;
    padding:5px 0; border-bottom:1px solid rgba(255,255,255,0.04);
    display:flex; align-items:flex-start; gap:8px;
  }
  .detail-block ul li::before { content:'→'; color:var(--red); flex-shrink:0; font-size:11px; margin-top:2px; }
  .tool-chips { display:flex; flex-wrap:wrap; gap:8px; margin-top:4px; }
  .chip {
    font-family:'IBM Plex Mono',monospace; font-size:10px;
    background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.12);
    border-radius:4px; padding:4px 10px; color:var(--text); letter-spacing:0.5px;
  }
  .chip.highlight { background:var(--red-glow); border-color:var(--border); color:var(--red); }

  /* ---- WHY NOT COPILOT ---- */
  .compare-grid {
    display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-bottom:48px;
  }
  .compare-card {
    border-radius:12px; padding:28px; border:1px solid;
  }
  .compare-card.no { border-color:rgba(200,50,50,0.3); background:rgba(200,50,50,0.05); }
  .compare-card.yes { border-color:rgba(50,180,100,0.3); background:rgba(50,180,100,0.05); }
  .compare-card h3 { font-family:'Syne',sans-serif; font-size:18px; font-weight:700; margin-bottom:6px; }
  .compare-card.no h3 { color:#F88; }
  .compare-card.yes h3 { color:#7CE; }
  .compare-card .sub { font-family:'IBM Plex Mono',monospace; font-size:11px; color:var(--dim); margin-bottom:18px; }
  .compare-card ul { list-style:none; }
  .compare-card ul li { font-size:13px; padding:7px 0; border-bottom:1px solid rgba(255,255,255,0.04); display:flex; gap:10px; }
  .compare-card.no ul li::before { content:'✗'; color:#F88; }
  .compare-card.yes ul li::before { content:'✓'; color:#7CE; }

  /* ---- TOOL STACK ---- */
  .tools-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
  .tool-card {
    border:1px solid var(--border); border-radius:12px;
    background:var(--card-bg); padding:24px;
    transition:all 0.2s;
  }
  .tool-card:hover { border-color:var(--red); transform:translateY(-3px); }
  .tool-icon {
    width:44px; height:44px; border-radius:8px;
    background:var(--red-glow); border:1px solid var(--border);
    display:flex; align-items:center; justify-content:center;
    font-size:20px; margin-bottom:16px;
  }
  .tool-card h3 { font-family:'Syne',sans-serif; font-size:16px; font-weight:700; margin-bottom:4px; }
  .tool-card .role { font-family:'IBM Plex Mono',monospace; font-size:10px; color:var(--red); letter-spacing:1px; margin-bottom:12px; }
  .tool-card p { font-size:13px; color:var(--warm-gray); line-height:1.6; }
  .tool-card .use-when { margin-top:12px; font-size:12px; font-family:'IBM Plex Mono',monospace; color:var(--dim); }

  /* ---- SETUP GUIDE ---- */
  .setup-steps { counter-reset:step; display:flex; flex-direction:column; gap:20px; }
  .setup-step {
    border:1px solid var(--border); border-radius:12px;
    background:var(--card-bg); padding:28px 32px;
    display:flex; gap:24px; align-items:flex-start;
    counter-increment:step;
  }
  .step-num {
    width:42px; height:42px; border-radius:50%;
    border:2px solid var(--red); color:var(--red);
    display:flex; align-items:center; justify-content:center;
    font-family:'Syne',sans-serif; font-weight:800; font-size:16px; flex-shrink:0;
  }
  .step-body { flex:1; }
  .step-body h3 { font-family:'Syne',sans-serif; font-size:16px; font-weight:700; margin-bottom:8px; }
  .step-body p { font-size:13px; color:var(--warm-gray); line-height:1.65; margin-bottom:12px; }
  .code-block {
    background:#111; border:1px solid rgba(255,255,255,0.08);
    border-radius:6px; padding:14px 18px;
    font-family:'IBM Plex Mono',monospace; font-size:12px;
    color:#A8E6CF; line-height:1.7; overflow-x:auto;
  }
  .code-block .comment { color:var(--dim); }
  .code-block .kw { color:#F8BBD9; }
  .code-block .str { color:#FFF9C4; }

  /* ---- ROI ---- */
  .roi-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:48px; }
  .roi-card {
    border:1px solid var(--border); border-radius:10px;
    background:var(--card-bg); padding:24px 20px; text-align:center;
  }
  .roi-num { font-family:'Syne',sans-serif; font-size:36px; font-weight:800; color:var(--red); }
  .roi-label { font-family:'IBM Plex Mono',monospace; font-size:10px; color:var(--dim); letter-spacing:1px; margin-top:6px; }

  /* ---- FOOTER ---- */
  footer {
    padding:32px 60px;
    border-top:1px solid var(--border);
    display:flex; justify-content:space-between; align-items:center;
    font-family:'IBM Plex Mono',monospace; font-size:11px; color:var(--dim);
  }

  /* SCROLLBAR */
  ::-webkit-scrollbar { width:6px; height:6px; }
  ::-webkit-scrollbar-track { background:var(--charcoal); }
  ::-webkit-scrollbar-thumb { background:var(--red-dark); border-radius:3px; }

  @media(max-width:768px){
    header { padding:28px 24px; flex-direction:column; gap:20px; }
    .header-title { text-align:left; }
    nav { padding:0 24px; }
    .section { padding:32px 24px; }
    .detail-grid { grid-template-columns:1fr; }
    .compare-grid { grid-template-columns:1fr; }
    .tools-grid { grid-template-columns:1fr; }
    .roi-grid { grid-template-columns:repeat(2,1fr); }
  }
</style>
</head>
<body>

<header>
  <div class="logo-block">
    <div class="trane-logo">TT</div>
    <div class="brand-text">
      <h1>Trane Technologies</h1>
      <p>// QUALITY ENGINEERING DIVISION</p>
    </div>
  </div>
  <div class="header-title">
    <h2>AI-Powered <span>Testing</span><br>Framework</h2>
    <p>// END-TO-END GUIDELINE v1.0 — 2025</p>
  </div>
</header>

<nav>
  <button class="active" onclick="showTab('flow')">Flow Diagram</button>
  <button onclick="showTab('why')">Why Not Copilot?</button>
  <button onclick="showTab('tools')">Tool Stack</button>
  <button onclick="showTab('setup')">Setup Guide</button>
  <button onclick="showTab('roi')">ROI & Metrics</button>
</nav>

<main>

<!-- ========== FLOW DIAGRAM ========== -->
<section class="section active" id="flow">
  <div class="sec-title">End-to-End <span>AI Testing</span> Flow</div>
  <div class="sec-sub">// CLICK EACH STAGE TO EXPAND DETAILS — MANUAL & SELENIUM COVERED</div>

  <div class="flow-wrap">

    <!-- STAGE 1 -->
    <div class="flow-stage">
      <div class="stage-card" onclick="toggleStage(this)">
        <div class="stage-header">
          <div class="stage-num">1</div>
          <div class="stage-info">
            <h3>Requirements Ingestion & Analysis</h3>
            <p>Feed business docs, user stories, BRDs into AI for automatic requirement parsing</p>
          </div>
          <span class="stage-badge">PLANNING</span>
          <div class="stage-toggle">▼</div>
        </div>
        <div class="stage-detail">
          <div class="detail-grid">
            <div class="detail-block">
              <h4>What Happens</h4>
              <ul>
                <li>Upload BRD, Jira stories, Confluence docs to AI</li>
                <li>AI extracts testable acceptance criteria automatically</li>
                <li>Gaps, ambiguities, and missing test conditions flagged</li>
                <li>Risk-ranked test priority list generated</li>
              </ul>
            </div>
            <div class="detail-block">
              <h4>AI Tools Used</h4>
              <div class="tool-chips">
                <span class="chip highlight">Testim AI</span>
                <span class="chip highlight">Claude API</span>
                <span class="chip">Jira + GPT plugin</span>
                <span class="chip">Confluence AI</span>
              </div>
              <h4 style="margin-top:16px;">Why This Matters</h4>
              <ul>
                <li>Zero manual reading of 200-page BRDs</li>
                <li>Catch missing requirements before dev starts</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="flow-connector"><div class="flow-line"></div><div class="flow-arrow"></div></div>

    <!-- STAGE 2 -->
    <div class="flow-stage">
      <div class="stage-card" onclick="toggleStage(this)">
        <div class="stage-header">
          <div class="stage-num">2</div>
          <div class="stage-info">
            <h3>AI Test Case Generation</h3>
            <p>Auto-generate detailed manual & automated test cases with steps, data, and expected results</p>
          </div>
          <span class="stage-badge">CORE AI</span>
          <div class="stage-toggle">▼</div>
        </div>
        <div class="stage-detail">
          <div class="detail-grid">
            <div class="detail-block">
              <h4>For Manual Testing</h4>
              <ul>
                <li>AI writes step-by-step test cases with preconditions</li>
                <li>Positive, negative, boundary, edge cases generated</li>
                <li>Test data suggestions with realistic Trane-domain values</li>
                <li>Traceability matrix auto-linked to requirements</li>
              </ul>
            </div>
            <div class="detail-block">
              <h4>For Selenium / Automation</h4>
              <ul>
                <li>AI generates Selenium Java/Python scripts from UI spec</li>
                <li>Page Object Model classes auto-scaffolded</li>
                <li>TestNG / JUnit annotations added automatically</li>
                <li>XPath and CSS selectors generated + validated</li>
              </ul>
            </div>
            <div class="detail-block">
              <h4>Primary Tool</h4>
              <div class="tool-chips">
                <span class="chip highlight">Testsigma AI</span>
                <span class="chip highlight">Applitools</span>
                <span class="chip">Katalon AI</span>
                <span class="chip">Diffblue Cover</span>
              </div>
            </div>
            <div class="detail-block">
              <h4>Prompt Strategy</h4>
              <ul>
                <li>"Generate BDD Gherkin scenarios for HVAC login flow"</li>
                <li>"Write Selenium tests for this API contract: [paste]"</li>
                <li>"Create negative test cases for this form validation"</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="flow-connector"><div class="flow-line"></div><div class="flow-arrow"></div></div>

    <!-- STAGE 3 -->
    <div class="flow-stage">
      <div class="stage-card" onclick="toggleStage(this)">
        <div class="stage-header">
          <div class="stage-num">3</div>
          <div class="stage-info">
            <h3>Test Review & Enrichment</h3>
            <p>AI peer-reviews generated tests, adds missing scenarios, and enriches test data</p>
          </div>
          <span class="stage-badge">QUALITY GATE</span>
          <div class="stage-toggle">▼</div>
        </div>
        <div class="stage-detail">
          <div class="detail-grid">
            <div class="detail-block">
              <h4>What AI Does</h4>
              <ul>
                <li>Duplicate test case detection and deduplication</li>
                <li>Coverage gap analysis against requirements</li>
                <li>Suggests data-driven variations automatically</li>
                <li>Flags tests that are too broad or ambiguous</li>
              </ul>
            </div>
            <div class="detail-block">
              <h4>Tools</h4>
              <div class="tool-chips">
                <span class="chip highlight">Claude / ChatGPT</span>
                <span class="chip">Testim Review</span>
                <span class="chip">Zephyr Scale</span>
                <span class="chip">Qase AI</span>
              </div>
              <h4 style="margin-top:16px;">Output</h4>
              <ul>
                <li>Reviewed test suite ready for execution</li>
                <li>Coverage heatmap of requirements vs tests</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="flow-connector"><div class="flow-line"></div><div class="flow-arrow"></div></div>

    <!-- STAGE 4 -->
    <div class="flow-stage">
      <div class="stage-card" onclick="toggleStage(this)">
        <div class="stage-header">
          <div class="stage-num">4</div>
          <div class="stage-info">
            <h3>Selenium Script Generation & Self-Healing</h3>
            <p>AI writes automation scripts and auto-repairs broken locators when UI changes</p>
          </div>
          <span class="stage-badge">AUTOMATION</span>
          <div class="stage-toggle">▼</div>
        </div>
        <div class="stage-detail">
          <div class="detail-grid">
            <div class="detail-block">
              <h4>Script Generation</h4>
              <ul>
                <li>Paste UI wireframe or live URL → AI writes Selenium scripts</li>
                <li>Framework: Java + TestNG + Maven (or Python + Pytest)</li>
                <li>POM pattern with reusable component classes</li>
                <li>CI/CD-ready with Jenkins / GitHub Actions hooks</li>
              </ul>
            </div>
            <div class="detail-block">
              <h4>Self-Healing (Game Changer)</h4>
              <ul>
                <li>When UI changes, AI detects broken XPath/CSS selectors</li>
                <li>Automatically finds the new correct locator</li>
                <li>No manual script maintenance after deployments</li>
                <li>Reduces flaky test failures by up to 70%</li>
              </ul>
            </div>
            <div class="detail-block">
              <h4>Key Tools</h4>
              <div class="tool-chips">
                <span class="chip highlight">Testim (Self-healing)</span>
                <span class="chip highlight">Healenium</span>
                <span class="chip">Selenium 4</span>
                <span class="chip">Appium AI</span>
                <span class="chip">LambdaTest AI</span>
              </div>
            </div>
            <div class="detail-block">
              <h4>Sample AI Prompt</h4>
              <ul>
                <li>"Generate Selenium Page Object for Trane thermostat config page"</li>
                <li>"Fix this broken XPath and explain why: [paste locator]"</li>
                <li>"Convert these manual steps to Selenium Java code"</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="flow-connector"><div class="flow-line"></div><div class="flow-arrow"></div></div>

    <!-- STAGE 5 -->
    <div class="flow-stage">
      <div class="stage-card" onclick="toggleStage(this)">
        <div class="stage-header">
          <div class="stage-num">5</div>
          <div class="stage-info">
            <h3>Intelligent Test Execution</h3>
            <p>AI prioritizes which tests to run, parallel execution, smart retry logic</p>
          </div>
          <span class="stage-badge">EXECUTION</span>
          <div class="stage-toggle">▼</div>
        </div>
        <div class="stage-detail">
          <div class="detail-grid">
            <div class="detail-block">
              <h4>AI Execution Features</h4>
              <ul>
                <li>Risk-based test selection — run only impacted tests</li>
                <li>Parallel execution across browsers and environments</li>
                <li>Smart retry: AI distinguishes flaky vs real failures</li>
                <li>Predictive test scheduling based on sprint changes</li>
              </ul>
            </div>
            <div class="detail-block">
              <h4>Manual Testing Support</h4>
              <ul>
                <li>AI assistant answers "what do I test next?" questions</li>
                <li>Context-aware hints during exploratory testing</li>
                <li>Session-based testing AI co-pilot</li>
                <li>Real-time defect likelihood scoring</li>
              </ul>
            </div>
            <div class="detail-block">
              <h4>Tools</h4>
              <div class="tool-chips">
                <span class="chip highlight">Mabl</span>
                <span class="chip highlight">Testim Cloud</span>
                <span class="chip">BrowserStack AI</span>
                <span class="chip">Sauce Labs AI</span>
                <span class="chip">Jenkins</span>
